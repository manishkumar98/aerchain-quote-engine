# ==============================================================================
# Aerchain QuoteEngine - Environment Variables
# ==============================================================================
#
# Create a local environment file by copying this template:
#   cp .env.example .env.local
#
# Next.js automatically loads variables from .env.local into process.env on the server.
#
# Optional LLM API Keys for Layer 1 Semantic Intent Parsing:
# If provided, Layer 1 queries the LLM to parse natural language queries into
# structured JSON AST filters. If omitted or upon network failure, the engine
# automatically falls back to deterministic heuristic parsing with 0 downtime.

# Google Gemini API Key (Recommended)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Or OpenAI API Key
# Obtain at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
